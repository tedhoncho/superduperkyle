# --- Server ---
PORT=4242
BASE_URL=http://localhost:4242
# Comma-separated list of origins allowed to embed/call this API (Kyle's real site domain(s) go here)
ALLOWED_ORIGINS=http://localhost:4242

# --- Stripe ---
# Test mode keys to start (from https://dashboard.stripe.com/test/apikeys).
# Swap for live keys (sk_live_..., pk_live_...) only once Kyle's Stripe account is connected.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` locally, or the webhook endpoint's signing secret in the Stripe Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Resend: https://resend.com) ---
RESEND_API_KEY=re_...
# Must be a verified sender on your Resend domain, e.g. music@superduperkyle.com
EMAIL_FROM="Super Duper Kyle <music@superduperkyle.com>"
ARTIST_NAME="Super Duper Kyle"

# --- Storage ---
# "local" for testing (files served from data/audio on this server's disk).
# "s3" for production (recommended: files live in S3/R2/B2, not on app disk).
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set this for S3-compatible providers other than AWS (Cloudflare R2, Backblaze B2)
S3_ENDPOINT=

# --- Download links ---
DOWNLOAD_LINK_EXPIRY_HOURS=168
DOWNLOAD_MAX_USES=5

# --- Admin (Kyle's upload dashboard at /admin) ---
# Set this to whatever password Kyle should type in at /admin. Anyone with
# this password can add/edit/delete songs — keep it private, don't reuse a
# password from anywhere else.
ADMIN_PASSWORD=
# Random long string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How many seconds of a song to use for the auto-generated preview clip.
PREVIEW_CLIP_SECONDS=25
